// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPERADMIN
  HR_MANAGER
  EMPLOYEE
}

enum ApprovalRequestType {
  CREATE_EMPLOYEE
  UPDATE_SALARY
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum TaxRegime {
  OLD
  NEW
}

enum PayrollRunStatus {
  DRAFT
  FINALIZED
}

enum EmploymentStage {
  PROBATION
  CONFIRMED
}

enum EmploymentBasis {
  PERMANENT
  CONTRACT
}

enum EmployeeCategory {
  NON_MANAGERIAL
  MANAGERIAL
}

enum PayMode {
  MONTHLY
  HOURLY_ATTENDANCE
  WAGE_BASED
}

enum WageRateType {
  HOURLY
  DAILY
}

enum DocumentCategory {
  TRAINING
  CHECKLIST
  DOCUMENT
}

enum LoanStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum ReimbursementCategory {
  TRAVEL
  MEDICAL
  OTHER
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// One row per SMB customer of this SaaS. Every other business record is
// scoped to an Organization for tenant isolation.
model Organization {
  id                           String    @id @default(cuid())
  name                         String
  legalName                    String?
  // Used on generated HR letters (offer/appointment/experience/relieving) —
  // blank renders as a placeholder there rather than blocking generation.
  address                      String?
  pan                          String?
  tan                          String?
  state                        String
  pfRegistrationNo             String?
  esiRegistrationNo            String?
  // Voluntary registration is possible below the statutory employee-count
  // threshold, so this is an explicit admin toggle rather than derived from
  // headcount.
  pfApplicable                 Boolean   @default(true)
  esiApplicable                Boolean   @default(true)
  financialYearStartMonth      Int       @default(4)
  // Null for self-service /signup orgs; set when provisioned from the
  // platform admin console instead.
  createdByPlatformAdminId     String?
  // Off by default so an org doesn't get surprise emails/costs until HR
  // opts in. Manual "Email payslip" sends ignore this toggle entirely.
  payslipEmailEnabled          Boolean   @default(false)
  // Off by default, same philosophy as payslipEmailEnabled — a weekly email
  // (to every SUPERADMIN) summarizing detected compliance gaps and upcoming
  // statutory deadlines, see src/lib/complianceDigest.ts. The in-app gap
  // card on the dashboard shows regardless of this toggle.
  complianceDigestEnabled      Boolean   @default(false)
  // Set after each weekly digest send so the sweep (instrumentation.ts, or
  // the manual /api/cron/compliance-digest trigger) knows which orgs are
  // due — not a schedule itself, just "don't re-send before 7 days pass".
  lastComplianceDigestSentAt   DateTime?
  // Link to a publicly-viewable image (e.g. a Google Drive "anyone with the
  // link" share, auto-rewritten to a direct-view URL by
  // src/lib/logoUrl.ts) — not an uploaded file, see that module's comment.
  logoUrl                      String?
  // Off by default so no org sees a surprise pay change until they opt in,
  // same philosophy as payslipEmailEnabled above. See src/lib/payrollEngine.ts.
  overtimeAutoCalculateEnabled Boolean   @default(false)
  standardHoursPerDay          Decimal   @default(8)
  overtimeRateMultiplier       Decimal   @default(2)
  // Off by default — hides all store/location UI (Settings, employee/HR
  // assignment, dashboard by-store stats, bulk-upload store column) for the
  // majority of orgs that operate from a single location.
  multiLocationEnabled         Boolean   @default(false)
  createdAt                    DateTime  @default(now())

  users                  User[]
  employees              Employee[]
  payrollRuns            PayrollRun[]
  caExportBatches        CAExportBatch[]
  approvalRequests       ApprovalRequest[]
  attendances            Attendance[]
  leavePolicy            LeavePolicy?
  certificates           Certificate[]
  companyDocuments       CompanyDocument[]
  stores                 Store[]
  loans                  Loan[]
  reimbursementClaims    ReimbursementClaim[]
  leaveRequests          LeaveRequest[]
  createdByPlatformAdmin PlatformAdmin?       @relation(fields: [createdByPlatformAdminId], references: [id])

  @@index([state])
}

// A physical location/centre, only relevant when multiLocationEnabled is on.
// Employee/User store assignment is informational only — it does not
// restrict data access (see AGENTS/plan notes for the "label only" decision).
model Store {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  employees    Employee[]
  hrManagers   User[]

  @@index([orgId])
}

// Deliberately separate from User/Organization — the SaaS operator's own
// login, not a tenant. No orgId, never appears in any tenant-scoped query,
// authenticated via its own session cookie (see src/lib/platformSession.ts)
// sealed with a different secret than the tenant session. Scoped narrowly to
// creating/listing companies — never opens a tenant's actual payroll data.
model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  createdOrganizations Organization[]
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(SUPERADMIN)
  // Set only for role=EMPLOYEE — links a self-service login to the payroll
  // record it's allowed to see.
  employeeId   String?  @unique
  // Which store/centre this HR manager is associated with — label only, does
  // NOT restrict what they can see or manage (every HR manager still sees
  // the whole org). Only meaningful when role=HR_MANAGER.
  storeId      String?
  createdAt    DateTime @default(now())

  organization        Organization         @relation(fields: [orgId], references: [id])
  employee            Employee?            @relation(fields: [employeeId], references: [id])
  store               Store?               @relation(fields: [storeId], references: [id])
  requestedApprovals  ApprovalRequest[]    @relation("RequestedApprovals")
  reviewedApprovals   ApprovalRequest[]    @relation("ReviewedApprovals")
  passwordResetTokens PasswordResetToken[]

  @@index([orgId])
}

// A single-use, expiring token for the self-service "forgot password" flow
// (see requestPasswordReset/resetPassword in authActions.ts). Emailed via
// sendMail — the email itself doesn't confirm whether the address is a real
// account, to avoid leaking which emails are registered.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Employee {
  id                        String           @id @default(cuid())
  orgId                     String
  employeeCode              String
  name                      String
  dob                       DateTime?
  gender                    String?
  doj                       DateTime
  // Set at exit — required before the experience/relieving letters can be
  // generated (see src/lib/hrLetters.ts).
  dol                       DateTime?
  // Only needed to create a self-service login (see User.employeeId) — not
  // used for payroll calculation.
  email                     String?
  pan                       String?
  uan                       String?
  // ESIC Insured Person (IP) number.
  esiNumber                 String?
  // Maharashtra Labour Welfare Fund labour identification number.
  mlwfIdNumber              String?
  bankAccountNo             String?
  bankIfsc                  String?
  // Drives which PTSlab applies and which org LeavePolicy is shown.
  state                     String
  pfApplicable              Boolean          @default(true)
  esiApplicable             Boolean          @default(true)
  // Per-employee PT opt-out, mirroring pfApplicable/esiApplicable above.
  ptApplicable              Boolean          @default(true)
  status                    EmployeeStatus   @default(ACTIVE)
  // Used on generated HR letters — "appointed as ___".
  designation               String?
  employmentStage           EmploymentStage  @default(PROBATION)
  // Relevant only while employmentStage=PROBATION.
  probationEndDate          DateTime?
  employmentBasis           EmploymentBasis  @default(PERMANENT)
  employeeCategory          EmployeeCategory @default(NON_MANAGERIAL)
  // MONTHLY = standard calendar-proration pay (existing behavior).
  // HOURLY_ATTENDANCE = still a monthly Basic, but with a free-leave
  // allowance before excessLeaveDailyDeduction kicks in on Basic only.
  // WAGE_BASED = no fixed monthly salary at all — gross pay each run is
  // wageRate × (hours or days actually worked, from Attendance), per
  // wageRateType. See src/lib/payrollEngine.ts.
  payMode                   PayMode          @default(MONTHLY)
  shiftHoursPerDay          Decimal?
  freeLeaveDaysPerMonth     Int?
  // Rupee deduction from Basic per day of absence beyond freeLeaveDaysPerMonth.
  // UI suggests basic÷daysInMonth as a default; HR can override per employee.
  excessLeaveDailyDeduction Decimal?
  wageRateType              WageRateType?
  wageRate                  Decimal?
  // Which store/centre this employee belongs to — only meaningful when the
  // org has multiLocationEnabled. See src/app/(app)/settings/page.tsx.
  storeId                   String?
  createdAt                 DateTime         @default(now())

  organization        Organization         @relation(fields: [orgId], references: [id])
  salaryStructures    SalaryStructure[]
  taxDeclarations     TaxDeclaration[]
  payslipLines        PayslipLine[]
  payrollAdjustments  PayrollAdjustment[]
  attendances         Attendance[]
  loginUser           User?
  visibleDocuments    CompanyDocument[]
  store               Store?               @relation(fields: [storeId], references: [id])
  loans               Loan[]
  reimbursementClaims ReimbursementClaim[]
  leaveRequests       LeaveRequest[]

  @@unique([orgId, employeeCode])
  @@index([orgId])
  @@index([orgId, status])
}

// Versioned by effectiveFrom so past payroll runs keep referencing the
// structure that was actually in force at the time, even after a revision.
model SalaryStructure {
  id               String   @id @default(cuid())
  employeeId       String
  effectiveFrom    DateTime
  basic            Decimal
  hra              Decimal
  // Dearness Allowance — included in the PF and ESI wage-basis formulas
  // alongside basic (see src/lib/statutory.ts), but not itself subject to
  // the HOURLY_ATTENDANCE free-leave/cutting rule (that applies to basic only).
  da               Decimal  @default(0)
  conveyance       Decimal  @default(0)
  medicalAllowance Decimal  @default(0)
  specialAllowance Decimal  @default(0)
  // Free-form extra components for org-specific allowances that don't
  // warrant their own column:
  // { name: string, amount: number, basis: "FIXED" | "ATTENDANCE" }[]
  // FIXED is paid in full regardless of attendance; ATTENDANCE is prorated
  // the same way basic/hra/etc. are (by days-paid ratio for MONTHLY
  // employees, or by days-present ratio for HOURLY_ATTENDANCE employees).
  otherAllowances  Json?
  createdAt        DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, effectiveFrom])
}

// Feeds the TDS estimate for a given financial year. One row per employee
// per FY; revising mid-year overwrites the same row rather than versioning,
// since the CA reconciles the final figure at year-end regardless.
model TaxDeclaration {
  id               String    @id @default(cuid())
  employeeId       String
  financialYear    String
  regime           TaxRegime @default(NEW)
  section80C       Decimal   @default(0)
  section80D       Decimal   @default(0)
  hraRentPaid      Decimal   @default(0)
  homeLoanInterest Decimal   @default(0)
  otherIncome      Decimal   @default(0)
  updatedAt        DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, financialYear])
}

model PayrollRun {
  id          String           @id @default(cuid())
  orgId       String
  month       Int
  year        Int
  status      PayrollRunStatus @default(DRAFT)
  finalizedAt DateTime?
  createdAt   DateTime         @default(now())

  organization       Organization        @relation(fields: [orgId], references: [id])
  payslipLines       PayslipLine[]
  caExportBatches    CAExportBatch[]
  payrollAdjustments PayrollAdjustment[]

  @@unique([orgId, month, year])
  @@index([orgId])
}

enum AdjustmentType {
  EARNING
  DEDUCTION
}

// A one-off amount for a single employee on a single run (e.g. a special
// allowance or a one-time deduction) — distinct from a SalaryStructure
// change, which is permanent and versioned. Only addable/removable while
// the parent run is DRAFT; excluded from PF/ESI wage base, same treatment
// as overtimeAmount below, since it's a fluctuating one-off, not stable
// recurring pay.
model PayrollAdjustment {
  id           String         @id @default(cuid())
  payrollRunId String
  employeeId   String
  name         String
  amount       Decimal
  type         AdjustmentType
  // Set when this row was auto-generated as a month's EMI for an active Loan
  // (see applyActiveLoanEmis in payrollActions.ts) rather than entered
  // manually — lets copyFromPreviousRun skip re-copying it (loans regenerate
  // their own EMI each run) and lets the Loan's repaid/outstanding balance
  // be derived by summing these rows on FINALIZED runs only, instead of a
  // separately-maintained counter that could drift out of sync.
  loanId       String?
  createdAt    DateTime       @default(now())

  payrollRun         PayrollRun          @relation(fields: [payrollRunId], references: [id])
  employee           Employee            @relation(fields: [employeeId], references: [id])
  loan               Loan?               @relation(fields: [loanId], references: [id], onDelete: SetNull)
  // No FK here — the FK lives on ReimbursementClaim.payrollAdjustmentId
  // (a claim maps to at most one adjustment). See removePayrollAdjustment,
  // which reverts the claim to APPROVED before deleting this row.
  reimbursementClaim ReimbursementClaim?

  @@index([payrollRunId])
  @@index([loanId])
}

// A fixed-EMI loan/advance given to an employee. The remaining balance is
// deliberately NOT a stored counter — it's derived on read by summing this
// loan's PayrollAdjustment rows on FINALIZED runs only (see
// src/lib/loans.ts), the same "frozen snapshot" philosophy as PayslipLine:
// a Draft run's EMI adjustment doesn't count against the balance until
// finalized, and there's nothing to reconcile if a Draft's EMI row is
// edited or removed before finalizing.
model Loan {
  id              String     @id @default(cuid())
  orgId           String
  employeeId      String
  name            String
  principalAmount Decimal
  emiAmount       Decimal
  status          LoanStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())

  organization Organization        @relation(fields: [orgId], references: [id])
  employee     Employee            @relation(fields: [employeeId], references: [id])
  adjustments  PayrollAdjustment[]

  @@index([orgId])
  @@index([employeeId])
}

// An employee-submitted travel/medical/other expense claim. Approved claims
// sit unpaid until HR explicitly adds one to a Draft payroll run (creating a
// normal EARNING PayrollAdjustment, same treatment as any other one-off —
// excluded from PF/ESI wage base), at which point the claim is marked PAID
// and linked to that adjustment. receiptUrl is a pasted link (e.g. a Drive
// share), not an uploaded file — same pattern as CompanyDocument.url.
model ReimbursementClaim {
  id                  String                @id @default(cuid())
  orgId               String
  employeeId          String
  category            ReimbursementCategory
  amount              Decimal
  description         String?
  receiptUrl          String?
  status              ReimbursementStatus   @default(PENDING)
  reviewNote          String?
  reviewedById        String?
  reviewedAt          DateTime?
  payrollAdjustmentId String?               @unique
  createdAt           DateTime              @default(now())

  organization      Organization       @relation(fields: [orgId], references: [id])
  employee          Employee           @relation(fields: [employeeId], references: [id])
  payrollAdjustment PayrollAdjustment? @relation(fields: [payrollAdjustmentId], references: [id])

  @@index([orgId, status])
  @@index([employeeId])
}

// An employee-submitted leave request against the org's LeavePolicy
// entitlement. Approving here is a record of the decision only — it does
// NOT touch Attendance or payroll (this app has no day-by-day leave-vs-work
// calendar; HOURLY_ATTENDANCE proration already runs off the separate
// Attendance import). "Leave taken" for the balance shown to the employee
// is derived by summing APPROVED requests falling in the current calendar
// year (a simplification — see LeavePolicy's own comment about entitlement
// not being FY-aware either).
model LeaveRequest {
  id           String             @id @default(cuid())
  orgId        String
  employeeId   String
  type         LeaveType
  fromDate     DateTime
  toDate       DateTime
  days         Decimal
  reason       String?
  status       LeaveRequestStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([orgId, status])
  @@index([employeeId])
}

// Immutable once the parent run is finalized — corrections happen via a new
// run, not by editing history. (A run can also be explicitly reverted to
// DRAFT — see revertPayrollRunToDraft — which is a deliberate, warned
// exception to that rule, not silent editing.)
model PayslipLine {
  id                  String   @id @default(cuid())
  payrollRunId        String
  employeeId          String
  daysInMonth         Int
  daysPaid            Decimal
  // Full earnings breakup at the time of the run ({ basic, hra, ... }).
  earnings            Json
  grossEarnings       Decimal
  pfWages             Decimal
  pfEmployee          Decimal
  pfEmployer          Decimal
  pfEps               Decimal
  pfEdli              Decimal
  esiWages            Decimal
  esiEmployee         Decimal
  esiEmployer         Decimal
  ptAmount            Decimal
  tdsAmount           Decimal
  // Rupee amount deducted from Basic for HOURLY_ATTENDANCE employees whose
  // absences exceeded their free-leave allowance that month. Zero for
  // MONTHLY employees. Recorded here (rather than only in `earnings`) so the
  // payslip PDF can show it as an explicit, transparent line.
  attendanceDeduction Decimal  @default(0)
  // Auto-calculated overtime pay (see src/lib/payrollEngine.ts) — zero
  // unless the org has overtimeAutoCalculateEnabled on. Stored separately
  // (not folded into grossEarnings) so PF/ESI wage-base figures elsewhere
  // stay base-earnings-only; included in netPay directly.
  overtimeAmount      Decimal  @default(0)
  // Signed net total of this run's PayrollAdjustment rows for this employee
  // (EARNING minus DEDUCTION) at the time this line was last computed.
  // Excluded from PF/ESI wage-base figures, same reasoning as overtimeAmount
  // above. The itemized list is folded into `earnings` for full detail.
  adjustmentsAmount   Decimal  @default(0)
  netPay              Decimal
  createdAt           DateTime @default(now())

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId])
}

// Admin-editable, state-specific Professional Tax slabs. PF (employee 12%;
// employer 12% EPS+EPF split + 0.5% EDLI, actually remitted and stored
// below as pfEmployer/pfEps/pfEdli — plus a budgeting-only 0.5% admin
// charge that brings employer PF *cost* to 13%, see calculatePF's
// pfAdminCharge in src/lib/statutory.ts) and ESI (0.75%/3.25% up to the
// wage ceiling) rates change rarely via government notification and are
// kept as versioned constants in code instead of a table.
model PTSlab {
  id            String   @id @default(cuid())
  state         String
  effectiveFrom DateTime
  minGross      Decimal
  maxGross      Decimal?
  monthlyAmount Decimal
  createdAt     DateTime @default(now())

  @@index([state, effectiveFrom])
}

// Statutory leave entitlement — an annual entitlement, not a running balance
// net of leave taken; there's no leave-tracking module yet. Earned leave is
// technically proportional to days worked, not a flat number — this is a
// full-year approximation. One row per org (editable by HR via Settings) —
// seeded from state defaults at signup/org-creation time
// (see src/lib/leavePolicyDefaults.ts), then independent per org from then
// on. Deliberately NOT state-keyed/shared: two different companies in the
// same state must be able to set different policies without affecting
// each other.
model LeavePolicy {
  id                 String   @id @default(cuid())
  orgId              String   @unique
  state              String
  casualLeavePerYear Int
  sickLeavePerYear   Int
  earnedLeavePerYear Int
  createdAt          DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([state])
}

// Company-level (not per-employee) certificate/registration expiry tracker
// — name and expiry date are filled in manually by HR, surfaced as dashboard
// reminders. See src/app/(app)/dashboard/page.tsx.
enum CertificateCategory {
  PF_REGISTRATION
  ESI_REGISTRATION
  GST_REGISTRATION
  SHOPS_ESTABLISHMENT
  TRADE_LICENCE
  OTHER
}

// Company-level certificate/registration expiry tracker. category is a
// preset hint used for grouping and default naming — OTHER covers a fully
// custom certificate, which still only needs a name and a manually entered
// expiryDate (no file required). fileData/fileMimeType/fileName are
// optional: a scanned/photographed copy of the certificate, stored inline
// (not a separate object-storage bucket, since addCertificateSchema caps
// uploads at 1MB) and served by /api/certificates/[id]/file.
model Certificate {
  id           String              @id @default(cuid())
  orgId        String
  name         String
  category     CertificateCategory @default(OTHER)
  expiryDate   DateTime
  fileData     Bytes?
  fileMimeType String?
  fileName     String?
  createdAt    DateTime            @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

// Admin-curated training material / checklists / documents, each a link
// (not an uploaded file — see src/app/(app)/documents/page.tsx) shared with
// specific employees chosen by the admin via the visibleTo relation. No
// separate "visible to all" flag — selecting every employee in the admin UI
// is the only way to broadcast, keeping one source of truth for who can see
// what.
model CompanyDocument {
  id        String           @id @default(cuid())
  orgId     String
  title     String
  category  DocumentCategory
  url       String
  createdAt DateTime         @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  visibleTo    Employee[]

  @@index([orgId])
}

// Daily attendance facts imported from a biometric-export-derived
// spreadsheet upload (see src/lib/attendanceImport.ts). Drives payroll
// calculation for HOURLY_ATTENDANCE employees only — see
// src/lib/payrollEngine.ts. Re-uploading a file upserts on
// (employeeId, date), so corrections are just a re-upload.
model Attendance {
  id          String   @id @default(cuid())
  orgId       String
  employeeId  String
  date        DateTime
  present     Boolean
  // Only populated/used for WAGE_BASED employees on HOURLY rate type — null
  // for everyone else (present/absent alone is enough for HOURLY_ATTENDANCE
  // and for DAILY-rate wage employees).
  hoursWorked Decimal?
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([orgId, date])
}

model IncomeTaxSlab {
  id            String    @id @default(cuid())
  regime        TaxRegime
  financialYear String
  minIncome     Decimal
  maxIncome     Decimal?
  rate          Decimal

  @@index([regime, financialYear])
}

// One row per generated CA handoff bundle for a finalized run.
model CAExportBatch {
  id            String   @id @default(cuid())
  orgId         String
  payrollRunId  String
  generatedAt   DateTime @default(now())
  generatedById String
  fileUrl       String?

  organization Organization @relation(fields: [orgId], references: [id])
  payrollRun   PayrollRun   @relation(fields: [payrollRunId], references: [id])

  @@index([orgId])
  @@index([payrollRunId])
}

// Sensitive edits made by HR_MANAGER (create employee, change salary) land
// here instead of writing directly — SUPERADMIN approves or rejects.
// Approving applies `payload` transactionally. SUPERADMIN's own edits skip
// this entirely and write directly, same as before this model existed.
model ApprovalRequest {
  id            String              @id @default(cuid())
  orgId         String
  type          ApprovalRequestType
  payload       Json
  status        ApprovalStatus      @default(PENDING)
  requestedById String
  reviewedById  String?
  reviewNote    String?
  createdAt     DateTime            @default(now())
  reviewedAt    DateTime?

  organization Organization @relation(fields: [orgId], references: [id])
  requestedBy  User         @relation("RequestedApprovals", fields: [requestedById], references: [id])
  reviewedBy   User?        @relation("ReviewedApprovals", fields: [reviewedById], references: [id])

  @@index([orgId, status])
}
